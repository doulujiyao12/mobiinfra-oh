export const RECORDING_MODEL_ID: string = 'sensevoice-20240717-3dspeaker-v1';
// Product/storage guard, not an AudioCapturer or SenseVoice limit.
export const RECORDING_MAX_SECONDS: number = 12 * 3600;
export const RECORDING_MAX_BYTES: number = 2 * 1024 * 1024 * 1024 - 1;
export const RECORDING_CHUNK_SECONDS: number = 300;
export interface SpeechRange { start: number; end: number; }
export interface RecordingSegment extends SpeechRange {
  id: number; speaker: number; text: string; language: string;
}
export interface RecordingSpeaker {
  id: number; name: string; seconds: number; embedding: number[];
}
export interface RecordingAnalysis {
  method?: string;
  modelId: string; duration: number; speech: SpeechRange[];
  segments: RecordingSegment[]; speakers: RecordingSpeaker[];
  timings?: RecordingStageTiming[];
}
export interface RecordingStageTiming {
  chunk: number; stage: string; milliseconds: number; audioSeconds: number; threads: number;
}
export interface RecordingRecord {
  schema: number; id: string; title: string; createdAt: string; source: string;
  duration: number; analysis: RecordingAnalysis | null;
  summary?: RecordingSummary;
  watch?: RecordingWatchSource;
  capturing?: boolean;
  audioSource?: string;
  titleEdited?: boolean;
  localSummaryDraft?: RecordingLocalSummaryDraft;
  audioDeleted?: boolean;
  transcriptionComplete?: boolean;
}
export interface RecordingWatchSource { sourceId: string; recordingId: string; sha256: string; }
export interface RecordingSummary {
  title: string; overview: string; keyPoints: string[]; decisions: string[];
  actionItems: string[]; openQuestions: string[]; model: string; generatedAt: string;
  source?: string;
  sections?: RecordingSummarySection[];
  partCount?: number;
  complete?: boolean;
}
export interface RecordingSummarySection { index: number; start: number; end: number; summary: RecordingSummary; }
export interface RecordingLocalSummaryDraft {
  policy: string; input: string; model: string; total: number; sections: RecordingSummarySection[];
  pendingResponse?: RecordingSummaryPendingResponse;
}
export interface RecordingSummaryPendingResponse { index: number; content: string; truncated: boolean; }
// Legacy records have no flag. Preserve unfamiliar existing names rather than
// assuming every title was generated by the app.
export function recordingUsesAutomaticTitle(record: RecordingRecord): boolean {
  if (record.titleEdited !== undefined) { return !record.titleEdited; }
  return record.title === '新录音' || record.title === '导入的录音' ||
    /^(录音|手表录音) (\d{2}:\d{2}|\d{1,4}[\/-]\d{1,2}[\/-]\d{1,4}[,， ]+\d{1,2}:\d{2}:\d{2}(\s*[AP]M)?)$/.test(record.title);
}
export function applyRecordingSummary(record: RecordingRecord, summary: RecordingSummary): void {
  let title = summary.title.replace(/\s+/g, ' ').trim().substring(0, 80);
  if (title && (recordingUsesAutomaticTitle(record) ||
    (record.titleEdited !== true && record.title === record.summary?.title))) {
    record.title = title; record.titleEdited = false;
  }
  record.summary = summary;
}
export interface RecordingJob {
  audioPath: string; modelDir: string; language: string;
  restart?: boolean;
  diarization?: boolean;
}
export interface RecordingWorkerMessage {
  kind: string; progress: number; message: string; result: RecordingAnalysis | null;
}
// A bounded visual overview; exact VAD intervals remain in the saved analysis.
export function recordingTimeline(speech: SpeechRange[], duration: number): SpeechRange[] {
  if (duration <= 0) { return []; }
  let bins: number[] = new Array<number>(160).fill(0);
  for (let range of speech) {
    let start = Math.max(0, Math.floor(range.start / duration * 160));
    let end = Math.min(160, Math.ceil(range.end / duration * 160));
    for (let index = start; index < end; index++) { bins[index] = 1; }
  }
  let result: SpeechRange[] = []; let start = -1;
  for (let index = 0; index <= 160; index++) {
    if (index < 160 && bins[index] === 1) { if (start < 0) { start = index; } }
    else if (start >= 0) { result.push({ start: start / 160 * duration, end: index / 160 * duration }); start = -1; }
  }
  return result;
}
export function recordingTime(seconds: number): string {
  let n = Math.max(0, Math.floor(seconds));
  return (n >= 3600 ? String(Math.floor(n / 3600)) + ':' : '') +
    String(Math.floor(n / 60) % 60).padStart(2, '0') + ':' + String(n % 60).padStart(2, '0');
}
export function voiceSimilarity(a: number[], b: number[]): number {
  if (a.length === 0 || a.length !== b.length) { throw new Error('声纹维度不一致，请使用相同模型重新分析'); }
  let dot = 0; let aa = 0; let bb = 0;
  for (let i = 0; i < a.length; i++) {
    if (!Number.isFinite(a[i]) || !Number.isFinite(b[i])) { throw new Error('声纹数据无效'); }
    dot += a[i] * b[i]; aa += a[i] * a[i]; bb += b[i] * b[i];
  }
  if (aa <= 0 || bb <= 0) { throw new Error('有效语音不足，无法比较声纹'); }
  return Math.max(-1, Math.min(1, dot / Math.sqrt(aa * bb)));
}
// Intersect diarization with VAD, splitting long turns to bound SenseVoice memory.
// Keep overlaps: simultaneous speakers must not be silently assigned to one person.
export function recordingTurns(turns: RecordingSegment[], speech: SpeechRange[]): RecordingSegment[] {
  let result: RecordingSegment[] = [];
  for (let turn of turns) {
    for (let range of speech) {
      let start = Math.max(turn.start, range.start); let end = Math.min(turn.end, range.end);
      while (end - start >= 0.15) {
        let stop = Math.min(end, start + 20);
        result.push({ id: result.length, start: start, end: stop, speaker: turn.speaker, text: '', language: '' });
        start = stop;
      }
    }
  }
  return result.sort((a: RecordingSegment, b: RecordingSegment): number => a.start - b.start || a.speaker - b.speaker);
}
