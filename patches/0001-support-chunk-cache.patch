+    void NPUBackend::resetLoadedTensorInfo() {
+        mInputDimension.clear();
+        mOutputDimension.clear();
+        mInputTensors.clear();
+        mOutputTensors.clear();
+        mMNNOutTensors.clear();
+        mOutputMemToIndex.clear();
+#if MNN_HIAI_USE_LOCAL_NPU_FIXES
+        if (!mInputOrder.empty()) {
+            mInputMap.clear();
+        }
+#endif
+    }
